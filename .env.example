# ─────────────────────────────────────────────────────────────
# COO Agent Server — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Server
PORT=8787
# A long random string. Every request must send `Authorization: Bearer <this>`.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN=

# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional: override the model. Defaults to claude-opus-4-8.
ANTHROPIC_MODEL=claude-opus-4-8

# ── Google Drive (document backbone) ─────────────────────────
# OAuth client from a Google Cloud project with the Drive API enabled.
# See README for the 10-minute walkthrough to obtain a refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Comma-separated Drive folder IDs the agent is allowed to read.
# Leave blank to disable Drive entirely.
GOOGLE_DRIVE_FOLDER_IDS=

# ── Toast (Maumee Street POS) ────────────────────────────────
# From Toast's Partner/API portal. Leave blank to disable Toast entirely.
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_RESTAURANT_GUID=
# Standard Toast API host (production). Sandbox host differs.
TOAST_API_HOST=https://ws-api.toasttab.com
# IANA timezone for the restaurant, used to compute "today's business date".
TOAST_TIMEZONE=America/New_York

# ── Square (Musgrove + Company) ──────────────────────────────
# A Square access token (Bearer). Leave blank to disable Square entirely.
SQUARE_ACCESS_TOKEN=
# Production host. Sandbox is https://connect.squareupsandbox.com
SQUARE_API_HOST=https://connect.squareup.com
# Optional: restrict to one location. Leave blank for all locations.
SQUARE_LOCATION_ID=
SQUARE_VERSION=2024-12-18
SQUARE_TIMEZONE=America/New_York

# ── Caching ──────────────────────────────────────────────────
# How long (seconds) to cache Drive + Toast pulls before refetching.
CONTEXT_CACHE_TTL_SECONDS=900
